{
  "translated": 1923,
  "auto_checked": 1906,
  "flagged": [
    {
      "id": "ex:235677",
      "source": "１年のこの時期は天候がよく変わる。",
      "th": "ช่วงนี้ของปีอากาศเปลี่ยนแปลงบ่อย",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:235670",
      "source": "１年中での楽しい時期です。",
      "th": "เป็นช่วงเวลาที่สนุกที่สุดช่วงหนึ่งของปี",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:74777",
      "source": "非常に高い収入を得るチャンスがあるビジネス、月額１００万円可能！！",
      "th": "ธุรกิจที่มีโอกาสสร้างรายได้สูงมาก เดือนละ 1 ล้านเยนก็เป็นไปได้!!",
      "warnings": [
        "number 100 missing"
      ]
    },
    {
      "id": "ex:196004",
      "source": "ボブは芝刈りに１時間３ドルを請求した。",
      "th": "บ็อบคิดค่าตัดหญ้าชั่วโมงละ 3 ดอลลาร์",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:139436",
      "source": "損害は５００万円に上った。",
      "th": "ความเสียหายสูงถึง 5 ล้านเยน",
      "warnings": [
        "number 500 missing"
      ]
    },
    {
      "id": "ex:236334",
      "source": "「行った」というのが適切な言葉だ。",
      "th": "\"行った\" (おこなった) เป็นคำที่เหมาะสม",
      "warnings": [
        "Japanese characters left in translation"
      ]
    },
    {
      "id": "ex:235844",
      "source": "１つのしぐさが様々な意味があるのと同じように多くの異なったしぐさが同一の意味を持つ事もある。",
      "th": "ท่าทางเดียวอาจมีหลายความหมาย และท่าทางที่ต่างกันก็อาจมีความหมายเดียวกันได้",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:218105",
      "source": "これは100万円の価値がある。",
      "th": "สิ่งนี้มีค่า 1 ล้านเยน",
      "warnings": [
        "number 100 missing"
      ]
    },
    {
      "id": "ex:225316",
      "source": "ケーキをあなた方２人で分けなさい。",
      "th": "แบ่งเค้กกันสองคนนะ",
      "warnings": [
        "number 2 missing"
      ]
    },
    {
      "id": "ex:74215",
      "source": "面疔ができた。小鼻の奥に1個、痛い塊がある。",
      "th": "เป็นฝีที่หน้า มีก้อนเจ็บๆ อยู่ด้านในจมูก",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:225629",
      "source": "クモはいつも自分たちの巣を３次元に織る。",
      "th": "แมงมุมถักใยแบบสามมิติเสมอ",
      "warnings": [
        "number 3 missing"
      ]
    },
    {
      "id": "ex:93529",
      "source": "彼女は４０代半ばで再婚した。",
      "th": "เธอแต่งงานใหม่ตอนอายุราวสี่สิบห้า",
      "warnings": [
        "number 40 missing"
      ]
    },
    {
      "id": "ex:84759",
      "source": "父は９時に帰宅した。",
      "th": "พ่อกลับบ้านตอน 3 ทุ่ม",
      "warnings": [
        "number 9 missing"
      ]
    },
    {
      "id": "ex:126313",
      "source": "虫歯は１本もありません。",
      "th": "ไม่มีฟันผุเลยสักซี่",
      "warnings": [
        "number 1 missing"
      ]
    },
    {
      "id": "ex:213458",
      "source": "その２チームは激しく戦った。",
      "th": "ทั้งสองทีมต่อสู้กันอย่างดุเดือด",
      "warnings": [
        "number 2 missing"
      ]
    },
    {
      "id": "ex:182260",
      "source": "去る６月に私の姉は高校の教師と結婚した。",
      "th": "เดือนมิถุนายนที่ผ่านมา พี่สาวแต่งงานกับครูมัธยมปลาย",
      "warnings": [
        "number 6 missing"
      ]
    },
    {
      "id": "ex:235469",
      "source": "２人なら仲間、３人は人込み。",
      "th": "สองคนเป็นเพื่อน สามคนเป็นฝูงชน",
      "warnings": [
        "number 2 missing",
        "number 3 missing"
      ]
    }
  ],
